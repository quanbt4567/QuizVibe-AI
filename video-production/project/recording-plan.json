  "safety_policy": {
    "environment": "DEMO_LOCAL_STRICT",
    "target_url": "${DEMO_LOCAL_URL}",
    "forbidden_on_production": [
      "NO form submissions on production",
      "NO password inputs or logins on production",
      "NO quiz creations or AI generation calls on production",
      "NO quiz session starts or answer submissions on production",
      "NO lead captures or voucher claims on production",
      "NO database mutations outside in-memory FakePostgrest"
    ]
  },
