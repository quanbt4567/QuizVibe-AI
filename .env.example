# ==============================================================================
# QuizVibe AI - Server-Side Environment Variables (Vercel Serverless Gateway)
# STRICT SECURITY POLICY: Never prefix server secrets with VITE_.
# Copy this file to `.env.local` for local development, and configure the same
# variables in Vercel -> Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (Server-Only — Phase 1 Multi-Device Backend)
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=""

# Privileged Service Role Key from Supabase Dashboard -> Project Settings -> API
# CRITICAL SECURITY RULE:
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser.
# - NEVER rename or duplicate it as VITE_SUPABASE_SERVICE_ROLE_KEY.
# - Used exclusively inside Vercel Serverless Functions (`api/`).
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Publishable / Anon Key (used for server-side RLS preflight verification)
SUPABASE_ANON_KEY=""

# ------------------------------------------------------------------------------
# 2. Admin Studio Authentication (Server-Only — Phase 2 Auth & Separation)
# ------------------------------------------------------------------------------
# Strong password (>= 8 characters) required to sign in at `/admin/login`.
# CRITICAL SECURITY RULE: Never prefix with VITE_ or store in browser storage.
ADMIN_PASSWORD=""

# REQUIRED independent random secret (>= 32 characters) used to sign HttpOnly Admin session cookies.
# Generate one with:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# It is NOT derived from ADMIN_PASSWORD or SUPABASE_SERVICE_ROLE_KEY any more; weak, short, placeholder,
# or password-derived values are rejected and Admin login/verification fails closed (HTTP 503).
# Session state lives in `public.admin_sessions` (apply migration 20261105000002). When Supabase is
# configured, every Admin request is verified against that table; on Vercel/production a missing or
# unreachable database means NO Admin access (no memory fallback).
ADMIN_SESSION_SECRET=""

# ------------------------------------------------------------------------------
# 3. Multi-Provider AI Gateway (Free-Only Budget Policy)
# ------------------------------------------------------------------------------
# Priority 1: Google Gemini (Active Free Tier)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Priority 2: Groq (Active Free Tier)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Priority 3: Cerebras (Optional / Disabled by default)
# Set ENABLE_CEREBRAS=true only if you have verified zero-cost trial without payment
ENABLE_CEREBRAS="false"
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="llama3.1-8b"

# ------------------------------------------------------------------------------
# 4. Session Token Migration & Compatibility Flags (Phase 4 Expand-Contract)
# ------------------------------------------------------------------------------
# Controls whether new quiz sessions dual-write plaintext `session_token` alongside
# `session_token_hash` during the Phase 4 expand-contract migration window.
# - "true" (or omitted / unset): Dual-write enabled (backward compatible with older Vercel instances).
# - "false": Hash-only mode (stops writing plaintext token; prerequisite for Gate 8 contract migration).
ENABLE_LEGACY_SESSION_TOKEN_WRITE="true"


