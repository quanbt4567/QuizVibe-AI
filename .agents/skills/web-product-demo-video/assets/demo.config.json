{
  "version": 1,
  "project_name": "web-product-demo",
  "start_url": "${DEMO_START_URL}",
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "duration_limit": 60.0,
    "opening_hold_seconds": 1.0,
    "audio": false
  },
  "captions": {
    "enabled": true,
    "font_name": "Arial",
    "font_size": 44,
    "bottom_margin": 58,
    "raised_margin": 210
  },
  "recording": {
    "headless": false,
    "storage_state_env": "DEMO_STORAGE_STATE",
    "output_video": "recordings/raw-session.webm",
    "marker_file": "recording-markers.json"
  },
  "editing": {
    "pre_roll_seconds": 0.2,
    "post_roll_seconds": 0.4,
    "default_transition": "cut"
  }
}
